@model K22CNT3_NVD_2210900016_DATN.Models.SanPham

@{
    ViewBag.Title = "Xóa sản phẩm";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .sp-frame {
        max-width: 950px;
        margin: 40px auto;
        background: #ffffff;
        padding: 35px 40px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.12);
    }

        .sp-frame h2 {
            text-align: center;
            font-weight: 700;
            margin-bottom: 15px;
            color: #dc3545;
        }

    .warning-text {
        text-align: center;
        font-size: 16px;
        margin-bottom: 25px;
        color: #555;
    }

    .sp-image {
        text-align: center;
        margin-bottom: 25px;
    }

        .sp-image img {
            max-width: 260px;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        }

    .dl-horizontal dt {
        font-weight: 600;
        width: 230px;
    }

    .dl-horizontal dd {
        margin-left: 250px;
        margin-bottom: 12px;
    }

    .sp-actions {
        text-align: center;
        margin-top: 30px;
    }

    .btn {
        border-radius: 8px;
        padding: 10px 26px;
    }
</style>

<div class="sp-frame">
    <h2>🗑 Xóa sản phẩm</h2>
    <p class="warning-text">
        ⚠ Bạn có chắc chắn muốn <strong>xóa vĩnh viễn</strong> sản phẩm này không?
    </p>

    <!-- HÌNH ẢNH (GIỐNG INDEX) -->
    <div class="sp-image">
        <img src="@(string.IsNullOrEmpty(Model.HinhAnh)
                    ? Url.Content("~/Content/Images/no-image.png")
                    : Model.HinhAnh)"
             alt="@Model.TenSP" />
    </div>

    <!-- THÔNG TIN SẢN PHẨM -->
    <dl class="dl-horizontal">
        <dt>Tên sản phẩm</dt>
        <dd>@Model.TenSP</dd>

        <dt>Thương hiệu</dt>
        <dd>@Model.ThuongHieu</dd>

        <dt>Đơn giá</dt>
        <dd>@Model.DonGia.ToString("N0") đ</dd>

        <dt>Số lượng</dt>
        <dd>@(Model.SoLuong ?? 0)</dd>

        <dt>Đơn vị tính</dt>
        <dd>@Model.DVT</dd>

        <dt>Bảo hành</dt>
        <dd>@(Model.BaoHanhThang ?? 0) tháng</dd>

        <dt>Trọng lượng</dt>
        <dd>@Model.TrongLuong</dd>

        <dt>Độ cứng</dt>
        <dd>@Model.DoCung</dd>

        <dt>Điểm cân bằng</dt>
        <dd>@Model.DiemCanBang</dd>

        <dt>Mức căng tối đa</dt>
        <dd>@(Model.MucCangToiDa ?? 0)</dd>

        <dt>Chất liệu khung</dt>
        <dd>@Model.ChatLieuKhung</dd>

        <dt>Đối tượng sử dụng</dt>
        <dd>@Model.DoiTuongSuDung</dd>

        <dt>Phong cách đánh</dt>
        <dd>@Model.PhongCachDanh</dd>

        <dt>Mô tả</dt>
        <dd>@Model.MoTa</dd>

        <dt>Trạng thái</dt>
        <dd>@(Model.TrangThai == true ? "Đang bán" : "Ngừng bán")</dd>
    </dl>

    <!-- BUTTON -->
    <div class="sp-actions">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="❌ Xóa sản phẩm" class="btn btn-danger" />
            @Html.ActionLink("↩ Quay lại", "Index", null,
                new { @class = "btn btn-secondary ms-2" })
        }
    </div>
</div>
