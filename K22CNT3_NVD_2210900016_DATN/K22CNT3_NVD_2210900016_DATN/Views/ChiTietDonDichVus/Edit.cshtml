@model K22CNT3_NVD_2210900016_DATN.Models.ChiTietDonDichVu

@{
    ViewBag.Title = "Chi tiết đơn dịch vụ";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-title {
        font-weight: 700;
        color: #0d6efd;
    }

    .custom-card {
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        border: none;
    }

    .info-label {
        font-weight: 600;
        color: #555;
    }

    .info-value {
        font-weight: 500;
    }

    .money {
        color: #198754;
        font-weight: 700;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="page-title">
            <i class="fas fa-eye"></i> Chi tiết đơn dịch vụ
        </h3>
    </div>

    <div class="card custom-card">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="info-label">Đơn dịch vụ</div>
                    <div class="info-value">@Model.DonDichVu.TenKhach</div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Dịch vụ</div>
                    <div class="info-value">@Model.DichVu.TenDichVu</div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Sản phẩm</div>
                    <div class="info-value">@Model.SanPham.TenSP</div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Số lượng</div>
                    <div class="info-value">@Model.SoLuong</div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Đơn giá</div>
                    <div class="info-value">@Model.DonGia</div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">Thành tiền</div>
                    <div class="info-value money">@Model.ThanhTien</div>
                </div>

                <div class="col-12">
                    <div class="info-label">Thông số kỹ thuật</div>
                    <div class="info-value">@Model.ThongSoKyThuat</div>
                </div>
            </div>

            <div class="mt-4 text-end">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>

                <a href="@Url.Action("Edit", new { id = Model.ID_CTDonDV })"
                   class="btn btn-warning ms-2">
                    <i class="fas fa-edit"></i> Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>
