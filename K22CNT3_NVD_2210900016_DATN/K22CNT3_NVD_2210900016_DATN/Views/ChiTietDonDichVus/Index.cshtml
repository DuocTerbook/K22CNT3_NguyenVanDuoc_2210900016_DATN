@model IEnumerable<K22CNT3_NVD_2210900016_DATN.Models.ChiTietDonDichVu>

@{
    ViewBag.Title = "Danh sách chi tiết đơn dịch vụ";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-title {
        font-weight: 700;
        color: #0d6efd;
    }

    .custom-card {
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        border: none;
    }

    .table th {
        background-color: #0d6efd;
        color: white;
        text-align: center;
        vertical-align: middle;
    }

    .table td {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f5ff;
        transition: .2s;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .text-money {
        font-weight: 600;
        color: #198754;
    }

    .truncate {
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="page-title">
            <i class="fas fa-list"></i> Danh sách chi tiết đơn dịch vụ
        </h3>

        <a href="@Url.Action("Create")" class="btn btn-success">
            <i class="fas fa-plus"></i> Thêm mới
        </a>
    </div>

    <div class="card custom-card">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th>Tên Khách</th>
                        <th>Dịch vụ</th>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th>Thông số kũ thuật</th>
                        <th width="140">Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DonDichVu.TenKhach</td>
                            <td>@item.DichVu.TenDichVu</td>
                            <td>@item.SanPham.TenSP</td>
                            <td class="text-center">@item.SoLuong</td>
                            <td class="text-end">@item.DonGia</td>
                            <td class="text-end text-money">@item.ThanhTien</td>
                            <td class="truncate" title="@item.ThongSoKyThuat">
                                @item.ThongSoKyThuat
                            </td>
                            <td class="text-center">
                                <a class="btn btn-warning btn-action"
                                   href="@Url.Action("Edit", new { id = item.ID_CTDonDV })"
                                   title="Sua">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <a class="btn btn-info btn-action text-white"
                                   href="@Url.Action("Details", new { id = item.ID_CTDonDV })"
                                   title="Chi tiet">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <a class="btn btn-danger btn-action"
                                   href="@Url.Action("Delete", new { id = item.ID_CTDonDV })"
                                   title="Xoa">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
