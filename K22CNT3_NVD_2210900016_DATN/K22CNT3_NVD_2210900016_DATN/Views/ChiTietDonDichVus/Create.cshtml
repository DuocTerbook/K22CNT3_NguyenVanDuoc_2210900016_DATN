@model K22CNT3_NVD_2210900016_DATN.Models.ChiTietDonDichVu

@{
    ViewBag.Title = "Thêm chi tiết đơn dịch vụ";
}

<style>
    .center-wrapper {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .form-card {
        width: 100%;
        max-width: 800px;
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

        .form-card h3 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: 600;
            color: #0d6efd;
        }

    .form-group label {
        font-weight: 600;
    }

    .btn + .btn {
        margin-left: 10px;
    }
</style>

<div class="center-wrapper">
    <div class="form-card">
        <h3>Thêm chi tiết đơn dịch vụ</h3>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- Đơn dịch vụ -->
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.ID_DonDV, "Đơn dịch vụ")
                @Html.DropDownList("ID_DonDV", null, "-- Chọn đơn dịch vụ --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ID_DonDV, "", new { @class = "text-danger" })
            </div>

            <!-- Dịch vụ -->
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.ID_DichVu, "Dịch vụ")
                @Html.DropDownList("ID_DichVu", null, "-- Chọn dịch vụ --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ID_DichVu, "", new { @class = "text-danger" })
            </div>

            <!-- Sản phẩm -->
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.ID_SP, "Sản phẩm")
                @Html.DropDownList("ID_SP", null, "-- Chọn sản phẩm --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ID_SP, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <!-- Số lượng -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.SoLuong)
                    @Html.EditorFor(m => m.SoLuong, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger" })
                </div>

                <!-- Đơn giá -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.DonGia)
                    @Html.EditorFor(m => m.DonGia, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.DonGia, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Thành tiền -->
            <div class="col-md-4">
                <label class="fw-bold">Thành tiền</label>
                <input type="text"
                       id="ThanhTienView"
                       class="form-control fw-bold text-success"
                       readonly />
            </div>

            <!-- Thông số kỹ thuật -->
            <div class="form-group mb-4">
                @Html.LabelFor(m => m.ThongSoKyThuat)
                @Html.TextAreaFor(m => m.ThongSoKyThuat, 3, 50,
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ThongSoKyThuat, "", new { @class = "text-danger" })
            </div>

            <!-- Buttons -->
            <div class="text-center">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fa fa-plus"></i> Thêm mới
                </button>
                @Html.ActionLink("Quay lại", "Index", null,
                    new { @class = "btn btn-secondary px-4" })
            </div>
        }
    </div>
</div>
<script>
    function tinhTien() {
        let sl = parseFloat(document.getElementById("SoLuong").value) || 0;
        let dg = parseFloat(document.getElementById("DonGia").value) || 0;
        let tt = sl * dg;

        document.getElementById("ThanhTienView").value =
            tt.toLocaleString("vi-VN") + " ₫";
    }

    document.getElementById("SoLuong").addEventListener("input", tinhTien);
    document.getElementById("DonGia").addEventListener("input", tinhTien);
</script>