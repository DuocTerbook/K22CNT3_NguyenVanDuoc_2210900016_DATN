@model K22CNT3_NVD_2210900016_DATN.Models.GioHang

@{
    ViewBag.Title = "Xác nhận thanh toán";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">🧾 Xác nhận thanh toán</h4>
                </div>

                <div class="card-body">

                    <!-- Thông tin khách hàng -->
                    <p class="text-center">
                        <strong>Khách hàng:</strong> @Model.KhachHang.TenKhach
                    </p>

                    <!-- Thông tin đơn hàng -->
                    <h5 class="mt-4 mb-3 fw-bold text-primary">
                        📦 Thông tin đơn hàng
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 1;
                                }
                                @foreach (var item in Model.GioHangChiTiets)
                                {
                                    <tr>
                                        <td>@stt</td>
                                        <td>@item.SanPham.TenSP</td>
                                        <td>@String.Format("{0:N0} ₫", item.SanPham.DonGia)</td>
                                        <td>@item.SoLuong</td>
                                        <td class="text-danger fw-bold">
                                            @String.Format("{0:N0} ₫", item.SanPham.DonGia * item.SoLuong)
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Tổng tiền -->
                    <p class="text-end fw-bold fs-5 text-danger mt-3">
                        Tổng tiền: @String.Format("{0:N0} ₫", Model.TongTien)
                    </p>

                    <hr />

                    <!-- Form thanh toán -->
                    @using (Html.BeginForm("ThanhToan", "GioHangChiTiets", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-4">
                            <label class="fw-bold d-block mb-2">
                                Phương thức thanh toán
                            </label>

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="PhuongThuc"
                                       id="tienMat"
                                       value="Tien mat"
                                       checked />
                                <label class="form-check-label" for="tienMat">
                                    💵 Thanh toán tiền mặt
                                </label>
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="PhuongThuc"
                                       id="chuyenKhoan"
                                       value="Chuyen khoan" />
                                <label class="form-check-label" for="chuyenKhoan">
                                    💳 Chuyển khoản ngân hàng
                                </label>
                                <!-- QR chuyển khoản -->
                                <div id="qrChuyenKhoan" class="text-center mt-4 d-none">
                                    <p class="fw-bold text-success mb-2">
                                        📱 Quét mã QR để chuyển khoản
                                    </p>

                                    <img src="~/Content/images/qr-vietcombank.png"
                                         alt="QR Vietcombank"
                                         class="img-fluid rounded shadow"
                                         style="max-width: 280px;" />

                                    <p class="mt-3 mb-0">
                                        <strong>Ngân hàng:</strong> Vietcombank
                                    </p>
                                    <p class="mb-0">
                                        <strong>Chủ tài khoản:</strong> NGUYEN VAN DUOC
                                    </p>
                                    <p class="mb-0">
                                        <strong>Số tài khoản:</strong> 1061285159
                                    </p>
                                    <p class="text-danger fw-bold">
                                        Nội dung CK: THANHTOAN_@Model.ID_GioHang
                                    </p>
                                </div>

                            </div>
                        </div>


                        <div class="text-center">
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                ✅ Xác nhận thanh toán
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tienMat = document.getElementById("tienMat");
        const chuyenKhoan = document.getElementById("chuyenKhoan");
        const qrBox = document.getElementById("qrChuyenKhoan");

        function toggleQR() {
            if (chuyenKhoan.checked) {
                qrBox.classList.remove("d-none");
            } else {
                qrBox.classList.add("d-none");
            }
        }

        tienMat.addEventListener("change", toggleQR);
        chuyenKhoan.addEventListener("change", toggleQR);

        toggleQR(); // load trang lần đầu
    });
</script>

